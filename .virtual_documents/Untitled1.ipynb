import json

with open("assignment3_data.json", "r") as f:
    recomm_data = json.load(f)


# build the recommendation feature
def get_recommendation(data):
    recommendation = []

    for user in data:
        curr_recomm = {
            "customer_name": user.get("customer_name"),
            "original_brand": user.get("brand"),
            "rating": user.get("rating"),
        }

        # Rule 1: rating >= 4 -> recommend same brand
        # Rule 2: rating < 4  -> recommend different brand
        if float(user["rating"]) >= 4:
            curr_recomm["recommended_brand"] = user.get("brand")
        else:
            curr_recomm["recommended_brand"] = (
                "Samsung" if user.get("brand") == "Apple" else "Apple"
            )

        recommendation.append(curr_recomm)

    return recommendation
    


output = get_recommendation(recomm_data)
for item in output:
    print(item)



