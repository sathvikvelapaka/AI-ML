# to get meaning ful insights from data
def get_insights(data):
    # average rating
    tot_rating = 0
    poor_rating = 0
    count = 0

    for user in data:
        if "rating" in user:
            rating = int(user["rating"])
            tot_rating += rating
            count += 1
            if rating <= 2:
                poor_rating += 1

    if count > 0:
        print(f"average rating= {tot_rating / count}")
        print(f"percentage poor rating = {(poor_rating / count) * 100}%")
    else:
        print("No ratings found in data")


