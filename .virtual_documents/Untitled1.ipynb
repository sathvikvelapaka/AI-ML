# duplication
def clean_data(data):
    cleaned_data = []
    unique_users = set()

    for user in data:
        # handling missing data
        raw_age = user.get("age")
        if raw_age == "" or raw_age is None:
            user["age"] = None

        # duplication check
        user_name = user.get("name")
        if user_name in unique_users:
            continue

        unique_users.add(user_name)
        cleaned_data.append(user)
        print(user)

    return cleaned_data


